{
  "namespace": "server_form",
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.cf_main_screen_content",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },
  "cf_main_screen_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.cf_switching_long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },
  "cf_switching_long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$flag_skywars": "§m§a",
    "$flag_shop": "§m§b",
    "controls": [
      {
        "vanilla@long_form": {
          "enabled": false,
          "visible": false,
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "none",
              "binding_name": "#title_text",
              "binding_name_override": "#title_text"
            },
            {
              "source_property_name": "(((#title_text - $flag_skywars) = #title_text) and ((#title_text - $flag_shop) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#visible"
            },
            {
              "source_property_name": "(((#title_text - $flag_skywars) = #title_text) and ((#title_text - $flag_shop) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#enabled"
            }
          ]
        }
      },
      {
        "skywars@server_form.cf_skywars_panel": {
          "enabled": false,
          "visible": false,
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "none",
              "binding_name": "#title_text",
              "binding_name_override": "#title_text"
            },
            {
              "source_property_name": "(not ((#title_text - $flag_skywars) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#visible"
            },
            {
              "source_property_name": "(not ((#title_text - $flag_skywars) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#enabled"
            }
          ]
        }
      },
      {
        "shop@server_form.cf_shop_panel": {
          "enabled": false,
          "visible": false,
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "none",
              "binding_name": "#title_text",
              "binding_name_override": "#title_text"
            },
            {
              "source_property_name": "(not ((#title_text - $flag_shop) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#visible"
            },
            {
              "source_property_name": "(not ((#title_text - $flag_shop) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#enabled"
            }
          ]
        }
      }
    ]
  },
  "cf_skywars_title": {
    "type": "label",
    "text": "#title_text",
    "font_type": "MinecraftTen",
    "color": "white",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [
      0,
      10
    ],
    "font_scale_factor": 1.5,
    "layer": 6,
    "shadow": true,
    "bindings": [
      {
        "binding_name": "#title_text",
        "binding_type": "global"
      }
    ]
  },
  "cf_skywars_desc": {
    "type": "label",
    "text": "#form_text",
    "color": [
      0.36,
      0.752,
      1
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [
      0,
      34
    ],
    "size": [
      "80%",
      "default"
    ],
    "text_alignment": "center",
    "line_padding": 2,
    "layer": 6,
    "shadow": true
  },
  "cf_skywars_buttons": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [
      200,
      "100%c"
    ],
    "offset": [
      0,
      70
    ],
    "layer": 5,
    "factory": {
      "name": "button_list_factory",
      "control_name": "server_form.cf_skywars_btn"
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "cf_skywars_btn@common.button": {
    "size": [
      "100%",
      26
    ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "default@server_form.cf_skywars_btn_face": {
          "$bg_tex": "textures/ui/button_borderless_light"
        }
      },
      {
        "hover@server_form.cf_skywars_btn_face": {
          "$bg_tex": "textures/ui/button_borderless_lighthover"
        }
      },
      {
        "pressed@server_form.cf_skywars_btn_face": {
          "$bg_tex": "textures/ui/button_borderless_light"
        }
      }
    ]
  },
  "cf_skywars_btn_face": {
    "type": "image",
    "texture": "$bg_tex",
    "$bg_tex|default": "textures/ui/button_borderless_light",
    "nineslice_size": [
      4,
      4,
      4,
      4
    ],
    "tiled": false,
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#form_button_text",
          "color": [
            1,
            1,
            1
          ],
          "text_alignment": "center",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [
            "100% - 8px",
            "default"
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            }
          ]
        }
      }
    ]
  },
  "cf_skywars_fondo_1": {
    "type": "image",
    "texture": "textures/ui/skywars_bg",
    "size": [
      "100%",
      "100%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [
      0,
      0
    ],
    "layer": 1,
    "keep_ratio": false
  },
  "cf_skywars_tip_2": {
    "type": "label",
    "text": "§7Sobrevive y gana",
    "color": [
      1,
      0.847,
      0.302
    ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [
      0,
      -8
    ],
    "layer": 20,
    "shadow": true
  },
  "cf_skywars_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "title@server_form.cf_skywars_title": {}
      },
      {
        "desc@server_form.cf_skywars_desc": {}
      },
      {
        "buttons@server_form.cf_skywars_buttons": {}
      },
      {
        "fondo_1@server_form.cf_skywars_fondo_1": {}
      },
      {
        "tip_2@server_form.cf_skywars_tip_2": {}
      }
    ]
  },
  "cf_shop_title": {
    "type": "label",
    "text": "#title_text",
    "font_type": "MinecraftTen",
    "color": "white",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [
      0,
      10
    ],
    "font_scale_factor": 1.5,
    "layer": 6,
    "shadow": true,
    "bindings": [
      {
        "binding_name": "#title_text",
        "binding_type": "global"
      }
    ]
  },
  "cf_shop_buttons": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [
      220,
      "100%c"
    ],
    "offset": [
      0,
      40
    ],
    "layer": 5,
    "factory": {
      "name": "button_list_factory",
      "control_name": "server_form.cf_shop_btn"
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "cf_shop_btn@common.button": {
    "size": [
      "100%",
      26
    ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "default@server_form.cf_shop_btn_face": {
          "$bg_tex": "textures/ui/button_borderless_light"
        }
      },
      {
        "hover@server_form.cf_shop_btn_face": {
          "$bg_tex": "textures/ui/button_borderless_lighthover"
        }
      },
      {
        "pressed@server_form.cf_shop_btn_face": {
          "$bg_tex": "textures/ui/button_borderless_light"
        }
      }
    ]
  },
  "cf_shop_btn_face": {
    "type": "image",
    "texture": "$bg_tex",
    "$bg_tex|default": "textures/ui/button_borderless_light",
    "nineslice_size": [
      4,
      4,
      4,
      4
    ],
    "tiled": false,
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#form_button_text",
          "color": [
            1,
            1,
            1
          ],
          "text_alignment": "center",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [
            "100% - 8px",
            "default"
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            }
          ]
        }
      }
    ]
  },
  "cf_shop_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "title@server_form.cf_shop_title": {}
      },
      {
        "buttons@server_form.cf_shop_buttons": {}
      }
    ]
  }
}
